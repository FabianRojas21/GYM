rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function hasFields(data, allowed, required) {
      return data is map &&
        data.keys().hasOnly(allowed) &&
        data.keys().hasAll(required);
    }

    function validDate(value) {
      return value is string && (
        value.matches('^[0-9]{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])$') ||
        value.matches('^[0-9]{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)$') ||
        value.matches('^[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])$') ||
        value.matches('^([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29$')
      );
    }

    function validSet(data) {
      return data is map &&
        data.keys().hasOnly(['w', 'r', 'rir', 'type', 'progression', 'targetMin',
          'targetMax', 'targetRir', 'loadPercent', 'stage', 'side', 'pair',
          'editorDone']) &&
        (!('type' in data) ||
          (data.type is string &&
           data.type.matches('^(normal|topset|warmup|backoff|dropset|restpause)$'))) &&
        (!('w' in data) || data.w == null || (data.w is number && data.w >= 0 && data.w <= 1000)) &&
        (!('r' in data) || data.r == null || (data.r is number && data.r >= 0 && data.r <= 100)) &&
        (!('rir' in data) || data.rir == null || (data.rir is number && data.rir >= 0 && data.rir <= 10)) &&
        (!('progression' in data) || data.progression is bool);
    }

    function validSessionEntry(data) {
      return data is map &&
        data.keys().hasOnly(['exId', 'unilateral', 'cfg', 'sets']) &&
        data.exId is string && data.exId.size() > 0 && data.exId.size() <= 128 &&
        data.unilateral is bool &&
        (data.cfg == null || data.cfg is map) &&
        validSets(data.sets);
    }

    function validEntries(data) {
      return data is list && data.size() <= 250 &&
        (data.size() <= 0 || validSessionEntry(data[0])) &&
        (data.size() <= 1 || validSessionEntry(data[1])) &&
        (data.size() <= 2 || validSessionEntry(data[2]));
    }

    function validSets(data) {
      return data is list && data.size() <= 60 &&
        (data.size() <= 0 || validSet(data[0])) &&
        (data.size() <= 1 || validSet(data[1])) &&
        (data.size() <= 2 || validSet(data[2]));
    }

    function validProfile(data) {
      return hasFields(
          data,
          ['v', 'settings', 'exercises', 'routines', 'programs', 'activeProgramId',
           'activeRoutineId', 'goals', 'measurements', 'recoveryRatings'],
          ['v', 'settings', 'exercises', 'routines', 'programs', 'activeProgramId',
           'activeRoutineId', 'goals', 'measurements', 'recoveryRatings']
        ) &&
        data.v == 2 &&
        data.settings is map && data.settings.size() <= 100 &&
        data.exercises is map && data.exercises.size() <= 300 &&
        data.routines is map && data.routines.size() <= 100 &&
        data.programs is map && data.programs.size() <= 50 &&
        data.goals is map && data.goals.size() <= 200 &&
        data.measurements is list && data.measurements.size() <= 2000 &&
        data.recoveryRatings is map && data.recoveryRatings.size() <= 50 &&
        (data.activeProgramId == null || data.activeProgramId is string) &&
        (data.activeRoutineId == null || data.activeRoutineId is string) &&
        (!('loadingTools' in data.settings) ||
          (data.settings.loadingTools is list && data.settings.loadingTools.size() <= 10)) &&
        (!('plateProfiles' in data.settings) ||
          (data.settings.plateProfiles is list && data.settings.plateProfiles.size() <= 20));
    }

    function validDraft(data) {
      return hasFields(
          data,
          ['date', 'startedAt', 'routineId', 'programId', 'entries', 'collapsedEntryIds',
           'updatedAt', 'restEndsAt', 'restOwner'],
          ['date', 'startedAt', 'routineId', 'programId', 'entries', 'collapsedEntryIds',
           'updatedAt', 'restEndsAt', 'restOwner']
        ) &&
        (data.date == null || validDate(data.date)) &&
        (data.startedAt == null || data.startedAt is int) &&
        (data.routineId == null || data.routineId is string) &&
        (data.programId == null || data.programId is string) &&
        data.entries is list && data.entries.size() <= 250 &&
        data.collapsedEntryIds is list && data.collapsedEntryIds.size() <= 250 &&
        data.updatedAt is int &&
        (data.restEndsAt == null || data.restEndsAt is int) &&
        (data.restOwner == null || data.restOwner is string);
    }

    function validSession(sessionId, data) {
      return hasFields(
          data,
          ['id', 'date', 'ts', 'startedAt', 'finishedAt', 'durationMs', 'entries',
           'routineId', 'routineName', 'programId', 'csvImport', 'updatedAt', 'updatedBy'],
          ['id', 'date', 'ts', 'startedAt', 'finishedAt', 'durationMs', 'entries',
           'updatedAt', 'updatedBy']
        ) &&
        data.id == sessionId &&
        sessionId.size() > 0 && sessionId.size() <= 128 &&
        validDate(data.date) &&
        data.ts is int && data.ts >= 0 && data.startedAt is int && data.startedAt >= 0 &&
        data.finishedAt is int && data.finishedAt >= data.startedAt &&
        data.durationMs is int && data.durationMs >= 0 &&
        validEntries(data.entries) &&
        data.updatedAt is int &&
        data.updatedBy is string && data.updatedBy.size() <= 128 &&
        (!('routineId' in data) || data.routineId is string) &&
        (!('routineName' in data) ||
          (data.routineName is string && data.routineName.size() <= 200)) &&
        (!('programId' in data) || data.programId is string) &&
        (!('csvImport' in data) || data.csvImport is bool);
    }

    match /users/{uid}/app/{documentId} {
      allow read, delete: if owns(uid) && documentId in ['state', 'draft'];
      allow create, update: if owns(uid) &&
        ((documentId == 'state' && validProfile(request.resource.data)) ||
         (documentId == 'draft' && validDraft(request.resource.data)));
    }

    match /users/{uid}/sessions/{sessionId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validSession(sessionId, request.resource.data);
    }
  }
}
