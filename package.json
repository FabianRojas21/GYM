{
  "name": "sobrecarga",
  "private": true,
  "scripts": {
    "test:unit": "node --test engine.test.js demo.test.js",
    "test:rules": "firebase emulators:exec --project demo-sobrecarga-tests --only firestore \"node --test firestore.rules.test.js\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.56.1",
    "firebase": "^11.0.0",
    "firebase-tools": "^15.35.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
